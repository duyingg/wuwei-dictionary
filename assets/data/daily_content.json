  {"id":"verse-1","type":"verse","title":"海内存知己，天涯若比邻。","summary":"真挚友情不受距离阻隔。","author":"王勃","sourceTitle":"送杜少府之任蜀州","sourceId":"public-domain"},
  {"id":"verse-2","type":"verse","title":"会当凌绝顶，一览众山小。","summary":"表达勇攀高峰的气概。","author":"杜甫","sourceTitle":"望岳","sourceId":"public-domain"},
  {"id":"verse-3","type":"verse","title":"大漠孤烟直，长河落日圆。","summary":"边塞景色开阔雄浑。","author":"王维","sourceTitle":"使至塞上","sourceId":"public-domain"},
  {"id":"verse-4","type":"verse","title":"江碧鸟逾白，山青花欲燃。","summary":"以鲜明色彩描绘暮春景致。","author":"杜甫","sourceTitle":"绝句二首","sourceId":"public-domain"},
  {"id":"verse-5","type":"verse","title":"明月松间照，清泉石上流。","summary":"山居秋夜清幽宁静。","author":"王维","sourceTitle":"山居秋暝","sourceId":"public-domain"},
  {"id":"verse-6","type":"verse","title":"潮平两岸阔，风正一帆悬。","summary":"江面开阔，舟行顺畅。","author":"王湾","sourceTitle":"次北固山下","sourceId":"public-domain"},
  {"id":"verse-7","type":"verse","title":"春风又绿江南岸，明月何时照我还。","summary":"写春景，也寄托归乡之思。","author":"王安石","sourceTitle":"泊船瓜洲","sourceId":"public-domain"},
  {"id":"verse-8","type":"verse","title":"山重水复疑无路，柳暗花明又一村。","summary":"困境中常会出现新的转机。","author":"陆游","sourceTitle":"游山西村","sourceId":"public-domain"},
  {"id":"verse-9","type":"verse","title":"欲穷千里目，更上一层楼。","summary":"要看得更远，就要登得更高。","author":"王之涣","sourceTitle":"登鹳雀楼","sourceId":"public-domain"},
  {"id":"verse-10","type":"verse","title":"采菊东篱下，悠然见南山。","summary":"表现闲适自然的田园生活。","author":"陶渊明","sourceTitle":"饮酒·其五","sourceId":"public-domain"}
